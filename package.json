  "description": "Busqueda laboral asistida: buscar, postular y llevar el seguimiento, con filtros definidos por el usuario, respuestas estrictas en formularios y aprobacion humana donde importa.",
  "scripts": {
    "test": "vitest run tests/targets/",
    "test:browser": "vitest run tests/browser/",
