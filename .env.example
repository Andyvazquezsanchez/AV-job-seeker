# Este archivo es OPCIONAL. El programa funciona sin ningun .env:
# la base de datos es local y se crea sola en la carpeta "datos".
#
# Para usar alguna de estas opciones, copia este archivo como ".env" y completa lo que necesites.

# Enviar correos por SMTP (scripts/send-email.js). En Gmail hace falta una "contrasena de aplicacion".
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=tu-correo@ejemplo.com
# SMTP_PASS=tu-contrasena-de-aplicacion

# Avanzado: usar un servidor PostgreSQL propio en lugar de la base local.
# DATABASE_URL=postgresql://usuario:clave@servidor:5432/base
